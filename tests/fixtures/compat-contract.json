{
  "format": "project-ledger-compat",
  "schema_version": "0.1.0",
  "contract": "frozen-v0",
  "_note": "Golden pin for the v0 flat compatibility observation contract (P1.1). entry_fields MUST equal ledger.models.CSV_FIELDS exactly (order + names) and MUST include schema_version. A rename, reorder, removal, or additive field breaks the drift test so field-meaning drift cannot slip through silently.",
  "envelope_keys": [
    "generated_at",
    "config_path",
    "entry_count",
    "entries"
  ],
  "entry_fields": [
    {"field": "project_hash", "role": "identity"},
    {"field": "project_key", "role": "identity"},
    {"field": "name", "role": "naming"},
    {"field": "project_type", "role": "naming"},
    {"field": "source_label", "role": "provenance"},
    {"field": "machine_name", "role": "provenance"},
    {"field": "storage_scope", "role": "provenance"},
    {"field": "shared", "role": "provenance"},
    {"field": "git", "role": "scan"},
    {"field": "obsidian", "role": "scan"},
    {"field": "repo_name", "role": "naming"},
    {"field": "remote_url", "role": "provenance"},
    {"field": "canonical_url", "role": "provenance"},
    {"field": "path", "role": "provenance"},
    {"field": "path_from_root", "role": "provenance"},
    {"field": "readme_path", "role": "navigation"},
    {"field": "readme_link_md", "role": "navigation"},
    {"field": "path_link_md", "role": "navigation"},
    {"field": "last_touch_at", "role": "navigation"},
    {"field": "head_branch", "role": "navigation"},
    {"field": "head_commit", "role": "navigation"},
    {"field": "head_commit_at", "role": "navigation"},
    {"field": "last_remote_ref_at", "role": "navigation"},
    {"field": "last_push_at", "role": "navigation"},
    {"field": "markdown_file_count", "role": "scan"},
    {"field": "obsidian_note_count", "role": "scan"},
    {"field": "tree_scan_truncated", "role": "scan"},
    {"field": "readme_sha256", "role": "scan"},
    {"field": "include_reason", "role": "scan"},
    {"field": "status", "role": "naming"},
    {"field": "tags", "role": "naming"},
    {"field": "description", "role": "naming"},
    {"field": "next_step", "role": "navigation"},
    {"field": "last_session_at", "role": "navigation"},
    {"field": "last_session_summary", "role": "navigation"},
    {"field": "sidecar_path", "role": "provenance"}
  ]
}